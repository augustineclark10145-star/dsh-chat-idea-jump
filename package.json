{
  "name": "dsh-chat-idea-jump",
  "version": "0.8.0",
  "description": "Click a file reference in DSH chat to open it in the right sidebar or an installed desktop editor at the exact line.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "intellij",
    "vscode",
    "editor",
    "file-jump"
  ],
  "homepage": "https://github.com/augustineclark10145-star/dsh-chat-idea-jump#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augustineclark10145-star/dsh-chat-idea-jump.git"
  },
  "bugs": {
    "url": "https://github.com/augustineclark10145-star/dsh-chat-idea-jump/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
